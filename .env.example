# B2BForce skills + workspace — copy to .env and fill locally. Never commit .env.
# API wrapper scripts require curl and jq.
#
# Variable usage by workflow:
#   FIRECRAWL_API_KEY    — monitoring crawl, company/service from URL
#   DATAFORSEO_LOGIN     — SERP competitor discovery, SEO research
#   DATAFORSEO_PASSWORD  — (pair with DATAFORSEO_LOGIN)
#   EXA_API_KEY          — market research enrichment

# --- Web scraping (monitoring, company/service from URL, landing page) ---
FIRECRAWL_API_KEY=

# --- SERP + SEO (competitor discovery, landing page, seo research) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Market research fallback (company/ICP enrichment) ---
EXA_API_KEY=
# PERPLEXITY_API_KEY=
